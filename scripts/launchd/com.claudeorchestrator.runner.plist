<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE — run scripts/setup-scheduler.sh to install.
     One-time setup to make this survive reboot (5 min total):
       1. System Settings → Privacy & Security → Full Disk Access → + → ClaudeRunner.app
       2. System Settings → General → Login Items → + → ClaudeRunner.app
       3. bash scripts/setup-scheduler.sh   (re-runs setup with the app's FDA)
     The KeepAlive=true here auto-restarts on crash. Login Items ensures it starts at boot. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudeorchestrator.runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP_DIR__/Contents/MacOS/ClaudeRunner</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!-- AbandonProcessGroup (2026-08-03): when the job head exits, launchd by default kills every
         remaining process sharing the job's process group. That group holds keepalive.sh, the
         working runner.py and ALL in-flight agent processes, so a single job restart wiped out
         agent runs mid-flight (TASK_TIMEOUT=900s vs a ~12min restart cycle = most runs killed).
         true = leave the group alone on restart. Crash recovery is unaffected: KeepAlive=true
         still relaunches a genuinely dead job head, and keepalive.sh's runner.lock /
         keepalive.lock singletons plus sentinel.py's extra-runner reaper prevent duplicates.
         REVERT: delete this key (and the ThrottleInterval stays as-is), then
           launchctl bootout gui/$(id -u)/com.claudeorchestrator.runner
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.claudeorchestrator.runner.plist -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StandardOutPath</key>
    <string>LOG_DIR/runner.log</string>
    <key>StandardErrorPath</key>
    <string>LOG_DIR/runner.err</string>
</dict>
</plist>
