{
  "name": "claude-orchestrator-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "prebuild": "npm run verify:contracts",
    "verify:contracts": "node scripts/verify-navigation-contract.mjs && node scripts/verify-admin-index.mjs && node scripts/verify-dependency-graph.mjs && node scripts/verify-journey-contracts.mjs",
    "verify:all": "for f in scripts/verify-*.mjs; do echo \"\u2500\u2500 $f\"; node \"$f\" || echo \"   ^ FAILING\"; done",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:integration": "node scripts/verify-embed-contracts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@darwin/kernel": "file:../packages/darwin-kernel",
    "@nuxt/cli": "^3.37.0",
    "@nuxtjs/supabase": "1.5.3",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/analytics": "^2.0.1",
    "chart.js": "^4.5.1",
    "nuxt": "^3.13.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.0.0",
    "typescript": "6.0.3",
    "vitest": "^1.0.0",
    "vue-tsc": "3.3.6"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
