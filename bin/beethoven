#!/usr/bin/env python3
"""The `beethoven` entrypoint.

This exists because `beethoven/` is a package DIRECTORY, so `beethoven consolidate`
and `beethoven backlog status` — named by the consolidation acceptance criteria —
had nothing to run. Put this directory on PATH, or invoke it as ./bin/beethoven.

Thin on purpose: dispatch only. Every behaviour lives in runner/, where it is
importable and testable without a shell.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                                "runner"))

import backlog_console  # noqa: E402

if __name__ == "__main__":
    sys.exit(backlog_console.main(sys.argv[1:]))
