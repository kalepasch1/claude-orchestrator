# npm derives `omit=dev` from NODE_ENV=production. The Claude desktop app runs
# with NODE_ENV=production and every shell it spawns inherits it, so an
# `npm install` run through an agent session silently skipped devDependencies —
# which is how this repo ended up with a vitest that had no dist/, an mcp/
# package with no typescript, and a rollup missing its native binding. An
# explicit `include=dev` wins over the NODE_ENV inference, so installs are the
# same whoever runs them. Use --omit=dev explicitly for a production install.
include=dev

# npm 10.9.8's arborist crashes resolving vitest's peer set —
# `TypeError: Cannot read properties of null (reading 'edgesOut')` thrown from
# #loadPeerSet in build-ideal-tree.js — which failed BOTH `npm ci` and
# `npm install` outright, so node_modules could not be created at all. With no
# node_modules there is no local typescript, and `npx tsc` then silently
# resolves the unrelated `tsc` package from the registry ("This is not the tsc
# command you are looking for"), which is why the toolchain report showed
# tsc failing and deps unwarmed at the same time: one cause, two symptoms.
#
# Peer resolution is what crashes, so skipping it is the fix available to us
# here; the alternative is pinning vitest away from the graph that trips the
# bug, which is a bigger call than a toolchain repair should make. Revisit when
# npm is upgraded — this is a workaround for an npm defect, not a project
# preference.
legacy-peer-deps=true
