#!/bin/sh
# Fleet pre-merge-commit hook (core.hooksPath = claude-orchestrator/runner/hooks).
#
# WHY THIS EXISTS
#   Operator directive 2026-08-02: "I don't ever want to lose any improved code to a merge."
#   The merge_train and auto_conflict_resolver paths now call runner/regression_guard.py
#   before they commit. This hook covers the third path: a HUMAN or an agent running
#   `git merge` by hand in a checkout. It runs after the merge tree is built and staged but
#   BEFORE the merge commit exists, so a rejection leaves nothing to undo — `git merge
#   --abort` restores the pre-merge state.
#
#   Fails the merge when the result drops or stubs a function/class that HEAD has, adds a
#   new undefined name, deletes a lockfile / CI config / vercel.json, or removes >50 net
#   lines from a file with no deletion intent in the merge message.
#
# ESCAPE HATCHES
#   git merge --no-verify …                  → skip all hooks
#   ORCH_MERGE_REGRESSION_GUARD=false git …  → skip only this gate
#
# Safe by design: a missing guard module is a no-op (the merge_train/auto_conflict_resolver
# call sites are the fail-closed ones; blocking every hand merge on a bad checkout is worse).
set -eu

GUARD=/Users/kpasch/Documents/beethoven/claude-orchestrator/runner/regression_guard.py

# Preserve any repo-local or package-manager hook installed before the fleet guard.
git_dir="$(git rev-parse --git-common-dir)"
case "$git_dir" in
  /*) ;;
  *) git_dir="$(pwd)/$git_dir" ;;
esac
legacy="$git_dir/hooks/pre-merge-commit"
if [ -x "$legacy" ] && [ "$legacy" != "$0" ]; then
  "$legacy" "$@"
fi

case "${ORCH_MERGE_REGRESSION_GUARD:-true}" in
  0|false|FALSE|no|NO|off|OFF) exit 0 ;;
esac

[ -f "$GUARD" ] || exit 0
command -v python3 > /dev/null 2>&1 || exit 0

msg=""
if [ -f "$git_dir/MERGE_MSG" ]; then
  msg="$(cat "$git_dir/MERGE_MSG")"
fi

echo "[pre-merge-commit] running anti-regression guard…"
if python3 "$GUARD" --repo . --base HEAD --message "$msg"; then
  exit 0
fi

cat >&2 <<'MSG'

[pre-merge-commit] ✗ REGRESSION GUARD FAILED — refusing the merge commit.

This merge would DESTROY code that exists in HEAD: a deleted or stubbed function, a
newly undefined name, a removed lockfile/CI config, or an unexplained mass deletion.
The specific findings are listed above.

Recover with:
  git merge --abort            # nothing was committed; you are back where you started

Then redo the merge keeping BOTH sides' code, or restore the named symbols by hand.

Override (use sparingly, and only when the deletion is genuinely intended):
  ORCH_MERGE_REGRESSION_GUARD=false git merge …
  git merge --no-verify …
MSG
exit 1
