#!/bin/sh
# Fleet pre-commit hook (core.hooksPath = claude-orchestrator/runner/hooks).
#
# WHY THIS EXISTS
#   Enforces the "landed but not wired" gate. Engine code that compiles, commits, and is
#   imported by NOTHING has repeatedly shipped, because merges/consolidations pick up
#   server/utils/** but drop the sibling API routes, page, nav line, cron registration, or
#   barrel exports. The gate lives in each repo as scripts/check-wiring.mjs +
#   wiring.config.json. Repos without those files are a silent no-op.
#
#   It also restores the repo's own sanctioned hook set (scripts/git-hooks/pre-commit,
#   installed by `npm run hooks:install`), which core.hooksPath would otherwise mask —
#   that is how tomorrow's migration-name lint got silently disabled.
#
# DELIBERATELY NOT DELEGATED TO
#   $GIT_DIR/hooks/pre-commit  — stale simple-git-hooks artifact running `npx lint-staged`
#                                against an invalid lint-staged config. It has been inert
#                                since core.hooksPath was set; running it would break every
#                                commit. Delete it or fix the config to re-enable.
#   .husky/pre-commit          — husky is not a dependency here (repo is deliberately
#                                dependency-free); no such hook exists.
#
# ESCAPE HATCHES
#   git commit --no-verify        → skip all hooks
#   SKIP_WIRING_GATE=1 git commit → skip only the wiring gate
#
# Safe by design: every step is optional and skipped when absent.
set -eu

# ── 0. Machine-local settings must never enter a commit ──────────────────────────
#
# .claude/settings.local.json is gitignored and holds this machine's Claude Code
# permission allowlist plus absolute home paths. It is nonetheless TRACKED on 616
# remote branches, and the mechanism is self-perpetuating: checking out one of
# those branches makes the file tracked in the working copy, the next stash
# captures it, sentinel's stash-rescue turns that stash into a
# hotfix/stash-rescue-* branch, and rescue_branch_durability pushes it. So the
# file spreads without anyone ever choosing to commit it.
#
# The ignore rule alone cannot stop that — git ignores only UNTRACKED paths, and
# on those branches it is already tracked. This refuses it at the one point every
# copy has to pass through. Staged deletions are allowed, so cleaning it up works.
_local_settings=$(git diff --cached --name-only --diff-filter=d | grep -x '\.claude/settings\.local\.json' || true)
if [ -n "$_local_settings" ]; then
  cat >&2 <<'MSG'
[pre-commit] ✗ .claude/settings.local.json is staged — refusing the commit.

This file is machine-local: it carries this box's Claude Code permission allowlist
and absolute home paths, and it is in .gitignore for that reason. It is already
tracked on old agent branches, which is why git's ignore rule does not catch it
here; that is the leak this hook closes.

  git rm --cached .claude/settings.local.json

Then commit again. To remove it from a branch that carries it, stage the deletion —
this hook allows that.
MSG
  exit 1
fi

# ── 1. The repo's own sanctioned hook set (masked by core.hooksPath otherwise) ────
if [ -x scripts/git-hooks/pre-commit ]; then
  self="$0"
  case "$self" in
    */scripts/git-hooks/pre-commit) ;;   # don't recurse into ourselves
    *) scripts/git-hooks/pre-commit "$@" ;;
  esac
fi

# ── 2. Wiring gate — only for repos that opted in ────────────────────────────────
if [ "${SKIP_WIRING_GATE:-0}" = "1" ]; then
  exit 0
fi

if [ -f scripts/check-wiring.mjs ] && [ -f wiring.config.json ]; then
  if ! command -v node > /dev/null 2>&1; then
    echo "[pre-commit] node not found — skipping wiring gate" >&2
    exit 0
  fi
  echo "[pre-commit] running wiring gate (landed-but-not-wired)…"
  if ! node scripts/check-wiring.mjs; then
    cat >&2 <<'MSG'
[pre-commit] ✗ WIRING GATE FAILED — refusing the commit.

Something landed but is not reachable: a dead engine, a barrel missing exports, an
unwired capability, a registry entry with no backing file, or a tracked file missing
from the worktree. The gate printed the exact fix above.

Common repairs:
  npm run gen:barrels          # regenerate a drifted barrel
  git checkout HEAD -- <path>  # restore a tracked file missing from the worktree

Override (use sparingly): SKIP_WIRING_GATE=1 git commit …   or   git commit --no-verify
MSG
    exit 1
  fi
fi

# ── 3. Runner source integrity: conflict markers + undefined names ───────────────
#
# WHY (2026-08-02): an unresolved `<<<<<<< HEAD` was committed into runner/db.py. db.py is the
# database layer, so every module importing it died with SyntaxError — merge_train (pushes),
# preflight (the QA gate), integration_sweeper, quarantine and remediate all went down at once
# and stayed down, while the fleet kept merging work locally that could never reach production.
# Separately, a full-tree pyflakes sweep found 42 undefined names outside the 14 modules the
# startup gate covers; one of them (blocker_quarantine's `max_depth`) crash-looped for weeks.
#
# Both classes are statically detectable in under a second, so neither should ever be committable.
# Escape hatch: SKIP_RUNNER_SANITY=1 git commit …
if [ "${SKIP_RUNNER_SANITY:-0}" != "1" ]; then
  _staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^runner/.*\.py$' || true)
  if [ -n "$_staged_py" ]; then
    _bad_markers=$(git diff --cached --name-only --diff-filter=ACM -G'^(<<<<<<< |>>>>>>> )' \
                     -- 'runner/*.py' || true)
    if [ -n "$_bad_markers" ]; then
      echo "[pre-commit] ✗ unresolved merge-conflict markers in:" >&2
      echo "$_bad_markers" | sed 's/^/    /' >&2
      echo "[pre-commit] Resolve the conflict before committing (this is what took the fleet down on 2026-08-02)." >&2
      exit 1
    fi
    for _f in $_staged_py; do
      [ -f "$_f" ] || continue
      if ! python3 -m py_compile "$_f" 2>/tmp/_pc.$$; then
        echo "[pre-commit] ✗ $_f does not compile:" >&2
        sed 's/^/    /' /tmp/_pc.$$ >&2; rm -f /tmp/_pc.$$
        exit 1
      fi
      rm -f /tmp/_pc.$$
    done
    if python3 -c 'import pyflakes' 2>/dev/null; then
      _undef=$(python3 -m pyflakes $_staged_py 2>/dev/null | grep 'undefined name' || true)
      if [ -n "$_undef" ]; then
        echo "[pre-commit] ✗ undefined names in staged runner code:" >&2
        echo "$_undef" | sed 's/^/    /' >&2
        echo "[pre-commit] Python only raises these at call time, so they ship silently and crash-loop a job later." >&2
        exit 1
      fi
    fi
  fi
fi


# ── 4. Commit identity: refuse HERE, where the fix is free ───────────────────────
#
# WHY AT COMMIT TIME, when author_identity_guard.py already runs at push time.
# Because the two moments have opposite economics, and the push guard is correctly
# lenient for its moment in a way that is wrong for this one:
#
#   at commit  nothing is published. `git commit --amend --reset-author` fixes it
#              in one command and costs nothing. So BOTH a wrong email and a wrong
#              display name are refused.
#   at push    a wrong name is on commits that may already be reachable elsewhere,
#              and the recommended rewrite forks published history. So the push
#              guard blocks a wrong EMAIL and only warns on a wrong NAME. That is
#              the right call there, and it is why 135 commits authored
#              "Kale Pasch <kalepasch@gmail.com>" across four repos exist at all:
#              nothing ever objected at the only moment objecting was cheap.
#
# The name is not cosmetic in practice even though §G calls it so. apparently-law's
# test/binding-rules.test.js asserts the exact author string, so a display-name drift
# does not merely look untidy — it fails a suite and costs a whole merge. This gate
# and that test now agree on the same rule, applied at the moment each can act on it.
#
# Escape hatches: SKIP_IDENTITY_GATE=1 git commit … | ORCH_AUTHOR_IDENTITY_GUARD=off
# Fail-soft: any error reading the identity allows the commit and says so.
if [ "${SKIP_IDENTITY_GATE:-0}" != "1" ] && [ "${ORCH_AUTHOR_IDENTITY_GUARD:-enforce}" != "off" ]; then
  _want_name="${ORCH_GIT_USER_NAME:-kalepasch1}"
  _want_email="${ORCH_GIT_USER_EMAIL:-kalepasch@gmail.com}"
  _want_login="${ORCH_GIT_USER_LOGIN:-kalepasch1}"

  _ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
  if [ -z "$_ident" ]; then
    echo "[pre-commit] identity unreadable — allowing the commit (fail-soft)" >&2
  else
    # "Name <email> 1788350000 -0400" → name, email
    _name=$(printf '%s' "$_ident" | sed -n 's/^\(.*\) <.*$/\1/p')
    _email=$(printf '%s' "$_ident" | sed -n 's/^.*<\([^>]*\)>.*$/\1/p')
    _email_lc=$(printf '%s' "$_email" | tr '[:upper:]' '[:lower:]')
    _want_email_lc=$(printf '%s' "$_want_email" | tr '[:upper:]' '[:lower:]')

    # The owner is the canonical address OR their GitHub noreply alias. The alias is
    # what GitHub stamps on every merge made through the web UI, and a 400-deployment
    # Vercel audit on 2026-08-17 found it deploying to production, so refusing it
    # would wedge the release train — which it did, on 2026-08-18.
    _owner=0
    [ "$_email_lc" = "$_want_email_lc" ] && _owner=1
    printf '%s' "$_email_lc" | grep -Eq "^([0-9]+\+)?${_want_login}@users\.noreply\.github\.com$" && _owner=1

    if [ "$_owner" -ne 1 ]; then
      cat >&2 <<MSG
[pre-commit] ✗ REFUSED — this commit would be authored <$_email>.

Vercel puts a production deploy whose commit author is anyone else into BLOCKED
state. Nothing fails loudly; the deploy simply never happens and the repo looks
healthy. Fixing it after the push means rewriting history.

    git config user.email "$_want_email"
    git config user.name  "$_want_name"

Break-glass: SKIP_IDENTITY_GATE=1 git commit …
MSG
      exit 1
    fi

    if [ "$_name" != "$_want_name" ]; then
      cat >&2 <<MSG
[pre-commit] ✗ REFUSED — this commit would be authored "$_name", not "$_want_name".

The email is right, so Vercel would deploy it. It is refused anyway because
apparently-law's test/binding-rules.test.js asserts the exact author string: a
display-name drift fails that suite and costs a whole merge to unpick. Right now
nothing is published and the fix is one command.

    git config user.name "$_want_name"

Break-glass: SKIP_IDENTITY_GATE=1 git commit …
MSG
      exit 1
    fi
  fi
fi

exit 0
