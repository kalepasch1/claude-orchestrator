+  ]
+})
+
+const promptInput = ref('')
+const promptPhase = ref<'idle' | 'analyzing' | 'generating' | 'complete'>('idle')
+const promptResult = ref('')
+const typingIndex = ref(0)
+let typingTimer: ReturnType<typeof setInterval> | null = null
+
+const exampleChips = [
+  'Form an LLC in Delaware',
+  'Draft an NDA for my startup',
+  'Get a gaming supplier license in PA',
+  'File a money transmitter license in TX'
+]
+
+function selectChip(chip: string) {
+  if (promptPhase.value !== 'idle') return
+  promptInput.value = ''
+  typingIndex.value = 0
+  if (typingTimer) clearInterval(typingTimer)
+  typingTimer = setInterval(() => {
+    if (typingIndex.value < chip.length) {
+      promptInput.value += chip[typingIndex.value]
+      typingIndex.value++
+    } else {
+      if (typingTimer) clearInterval(typingTimer)
+      typingTimer = null
+      simulateResponse()
+    }
+  }, 35)
+}
+
+function handlePromptSubmit() {
+  if (!promptInput.value.trim() || promptPhase.value !== 'idle') return
+  simulateResponse()
+}
+
+function simulateResponse() {
+  promptPhase.value = 'analyzing'
+  setTimeout(() => {
+    promptPhase.value = 'generating'
+    setTimeout(() => {
+      promptPhase.value = 'complete'
+      promptResult.value = promptInput.value
+    }, 1800)
+  }, 1200)
+}
+
+function resetPrompt() {
+  promptPhase.value = 'idle'
+  promptInput.value = ''
+  promptResult.value = ''
+}
+
+const verticals = [
